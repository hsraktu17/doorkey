# Copy to .env and fill in. These three keys are free, with no card needed.
# Write values without quotes: KEY=abc, not KEY="abc".
# Gemini:     https://aistudio.google.com/apikey
# Groq:       https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional, NOT free: Hugging Face gives free accounts no Inference Providers
# credit, so this needs purchased credits (or a PRO plan).
# https://huggingface.co/settings/tokens ("Make calls to Inference Providers")
HF_TOKEN=
